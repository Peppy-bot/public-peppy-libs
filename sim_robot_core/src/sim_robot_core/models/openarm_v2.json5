// How the engines render the cameras of an OpenArm v2, by the name each has
// in the description, whose optical frames place them. The streams mirror
// the real v2 record rig: 960x600 wrists, the chest at hd720 with depth at
// downscale 2, all at 15 fps. The chest's rgbd stream is the rectified left
// eye of its ZED Mini, measuring the depths the description's depth sensor
// gives the chest camera.
{
  cameras: {
    wrist_left: { fovy_deg: 66.0, color: { width: 960, height: 600 }, fps: 15 },
    wrist_right: { fovy_deg: 66.0, color: { width: 960, height: 600 }, fps: 15 },
    chest: {
      fovy_deg: 52.0,
      color: { width: 1280, height: 720 },
      depth: { width: 640, height: 360 },
      fps: 15,
    },
  },
}
