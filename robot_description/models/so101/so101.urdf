  <!-- The color optical frame of each camera the robot carries, as REP-103 gives a
       camera's frame: +x to the right of the image, +y down it, +z along the view.
       The wrist camera is an Innomaker U20CAM-1080P, the 32x32 mm UVC module of
       SO-ARM100's wrist camera mount, screwed to the gripper and looking past the fixed
       jaw at the grasp. Its frame is the one MuJoCo Menagerie gives its wrist_cam on that
       mount: 55 mm along the gripper link's +Y and 45 mm along its -Z, the way the jaw
       tips point, tilted 0.57 rad about its x axis so that the tool point is in view. -->
  <link name="wrist_optical_frame"/>
  <joint name="wrist_optical_joint" type="fixed">
    <origin rpy="2.5715925867 0.0000000000 0.0000000000" xyz="0.0 0.055 -0.045"/>
    <parent link="gripper_link"/>
    <child link="wrist_optical_frame"/>
