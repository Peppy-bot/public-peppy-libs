<?xml version="1.0" encoding="UTF-8"?>
<!--
  robot_description/tools/botshare_base.py writes this file. A base has no arm
  and no gripper, so it has no group and no named state. Each pair of links
  with collision geometry is disabled: Adjacent for two links that one joint
  joins, or that links with no collision geometry alone join between them, and
  Never for two whose bounds in the robot frame stand apart, which they do
  wherever the wheels turn.
-->
<robot name="botshare_base">
    <disable_collisions link1="base_link" link2="bl_caster_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="bl_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="br_caster_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="br_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="fl_caster_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="fl_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="fr_caster_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="left_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="lidar_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="right_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="bl_caster_link" link2="bl_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="bl_caster_link" link2="br_caster_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="br_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="fl_caster_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="fl_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="bl_caster_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="br_caster_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="br_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="fl_caster_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="fl_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="bl_wheel_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="br_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="br_caster_link" link2="fl_caster_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="fl_wheel_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="br_caster_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="fl_caster_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="fl_wheel_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="br_wheel_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_caster_link" link2="fl_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="fl_caster_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="fl_caster_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_caster_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_caster_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fl_caster_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_wheel_link" link2="fr_caster_link" reason="Never"/>
    <disable_collisions link1="fl_wheel_link" link2="fr_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_wheel_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="fl_wheel_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fl_wheel_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="fr_caster_link" link2="fr_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="fr_caster_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="fr_caster_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fr_caster_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="fr_wheel_link" link2="left_wheel_link" reason="Never"/>
    <disable_collisions link1="fr_wheel_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="fr_wheel_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="left_wheel_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="left_wheel_link" link2="right_wheel_link" reason="Never"/>
    <disable_collisions link1="lidar_link" link2="right_wheel_link" reason="Never"/>
</robot>
