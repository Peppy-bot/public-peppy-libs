"""The types of robot_description_py, the extension module built from src/lib.rs."""

from os import PathLike
from typing import ClassVar, Final, final

type _Vector3 = tuple[float, float, float]
"""A point or a set of angles, ``(x, y, z)`` or ``(roll, pitch, yaw)``."""

READY: Final[str]
HOME: Final[str]
START: Final[str]
PARK: Final[str]
CLOSED: Final[str]
OPEN: Final[str]

def model(id: str) -> Model: ...
def models() -> tuple[Model, ...]: ...

@final
class Model:
    @property
    def id(self) -> str: ...
    @property
    def urdf(self) -> str: ...
    @property
    def srdf(self) -> str: ...
    @property
    def digest(self) -> str: ...
    @property
    def meshes(self) -> tuple[tuple[str, bytes], ...]: ...
    def write_to(self, directory: str | PathLike[str]) -> None: ...
    def description(self) -> RobotDescription: ...

@final
class RobotDescription:
    @staticmethod
    def parse(urdf: str, srdf: str) -> RobotDescription: ...
    @property
    def urdf(self) -> str: ...
    @property
    def srdf(self) -> str: ...
    @property
    def arms(self) -> tuple[Arm, ...]: ...
    def state(self, group: str, name: str) -> list[float]: ...
    @property
    def cameras(self) -> tuple[CameraFrame, ...]: ...
    @property
    def root_link(self) -> str: ...
    def arm_carrying(self, link: str) -> Arm | None: ...
    def joint_limits(self, joint: str) -> JointLimits: ...
    def differential_base(self) -> DifferentialBase: ...
    def fixed_transforms(self) -> tuple[LinkTransform, ...]: ...
    def link_frames_at_zero(self) -> tuple[LinkTransform, ...]: ...
    def transforms_at(self, positions: dict[str, float]) -> tuple[LinkTransform, ...]: ...

